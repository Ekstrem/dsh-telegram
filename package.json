{
  "name": "dsh-telegram-ex",
  "version": "0.3.0",
  "description": "Telegram channel for DeepSeek Harness with a Russian interface, workspace-grouped session switching and a last-answer command",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "telegram",
    "chatbot",
    "plugin",
    "russian"
  ],
  "homepage": "https://github.com/Ekstrem/dsh-telegram#readme",
  "bugs": "https://github.com/Ekstrem/dsh-telegram/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekstrem/dsh-telegram.git"
  },
  "author": "Gum97",
  "contributors": [
    "Ekstrem"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./markdown": "./lib/markdown.js",
    "./api": "./lib/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  }
}
